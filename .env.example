# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is listed in .gitignore.

# ── PostgreSQL (used by Docker Compose to create the database) ──────────────
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=energy

# ── Application DB connection (used by the Python backend & ETL) ────────────
# Set DB_HOST=localhost when running backend locally (outside Docker).
# Set DB_HOST=db when running inside Docker Compose.
DB_USER=energy_user
DB_PASS=change_me_in_production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=energy

# ── PGAdmin (optional dev tool) ─────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# ── AI / LLM (optional — leave blank to use built-in TF-IDF RAG) ────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
